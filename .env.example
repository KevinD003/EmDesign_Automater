# Root env example. Copy per-app and fill with REAL values there (those .env files are gitignored):
#   cp apps/frontend/.env.example apps/frontend/.env
#   cp apps/backend/.env.example  apps/backend/.env
#
# Supabase (spec §8) — required to wire auth/persistence (Phase 6).
# NOTE: SUPABASE_URL is the API endpoint https://<project-ref>.supabase.co
#       — NOT the dashboard URL (https://supabase.com/dashboard/project/<ref>).
# NEVER put a real SERVICE key in this tracked file — it bypasses RLS. Put it only in .env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# Direct Postgres DSN — needed only to APPLY db/schema.sql (DDL). Put the REAL one in
# apps/backend/.env (gitignored), NEVER here. Password with @/: must be URL-encoded (@ -> %40).
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# --- Localhost/LAN launch (see docs/LAUNCH.md) ---
# CORS: the Vite server proxies /api and /health to the backend (apps/frontend/
# vite.config.ts), so browsers stay same-origin on :5173 and CORS never fires —
# no change needed for the normal LAN deployment. Set CORS_ORIGINS only when a
# browser page served from elsewhere calls the backend on :8000 directly.
# Env var name verified against app/config.py (pydantic-settings field
# `cors_origins`, no prefix, case-insensitive); value must be a JSON list —
# a non-JSON value aborts backend startup (config.py builds Settings at import).
# CORS_ORIGINS=["http://localhost:5173","http://192.168.1.50:5173"]
#
# Workers: without Supabase keys, designs fall back to local JSON files under
# data/designs/ with no cross-process locking (app/routers/designs.py), so run
# uvicorn with a single worker (--workers 1) in keyless mode. Multiple workers
# are safe only with SUPABASE_URL + SUPABASE_SERVICE_KEY set.