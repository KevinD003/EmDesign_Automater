# coverage artifacts
.coverage

# Local runtime data: user profiles (PBKDF2 hashes + live session tokens) and
# saved designs. Committing these leaks working credentials — a token from git
# authenticated against a fresh server 22h later (v2 Part 21 review).
apps/backend/data/
# Generated corpus tiers B and C (regenerated by scripts/build_corpus100.py with a
# fixed seed). Tier A — the real user photographs and the bench fixtures — IS
# tracked: those are genuine test inputs, not generated ones.
apps/backend/tests/fixtures/corpus100/B*.png
apps/backend/tests/fixtures/corpus100/C*.png
# FOUR EXCEPTIONS. The reason above — "generated, regenerated with a fixed
# seed" — is correct for a CORPUS and wrong for a BASELINE. These four are
# cited by name in DET2's fourteen-fixture table, they carry SH2's 12.53 % and
# 2.66 % reference figures, and C24 is the fixture the whole SH2 D1/D2 decision
# turns on. A baseline that regenerates is not a baseline.
#
# Untracked, they also took CI red while the local suite read green: run
# 31658769064 errored 16 times on FileNotFoundError for paths that exist only
# on a machine where build_corpus100.py has been run. Their sha256 is pinned in
# tests/test_corpus_baseline_fixtures.py so a regenerated image that differs is
# caught rather than silently re-baselining SH2's numbers.
!apps/backend/tests/fixtures/corpus100/C05_gradient_field.png
!apps/backend/tests/fixtures/corpus100/C11_many_colours.png
!apps/backend/tests/fixtures/corpus100/C18_gradient_field.png
!apps/backend/tests/fixtures/corpus100/C24_many_colours.png
apps/backend/scripts/corpus100*.json

# Visual-regression failure artifacts (v2 Part 44). The BASELINES under
# apps/backend/tests/visual/baselines/ are committed and are the reference;
# diffs/ is written only when a render disagrees with one, so it is output to
# look at, never something to check in.
apps/backend/tests/visual/diffs/
apps/backend/tests/visual/contact-sheet.png

# The real-job comparison harness writes here (scripts/compare_expert.py). The
# self-test sheet is regenerated on every run and carries no information between
# runs; a real job's sheet is worth keeping and is committed by name when there
# is one, rather than by sweeping in whatever the last run happened to produce.
docs/benchmarks/real-jobs/self-test.png
